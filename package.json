{
  "name": "pi-compact-assistant",
  "version": "0.0.6",
  "description": "Context-threshold compaction guidance and a model-callable compact tool for Pi",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/2h2d-co/pi-compact-assistant#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-compact-assistant/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-compact-assistant.git"
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "env -u PI_PACKAGE_DIR node --test --test-concurrency=1 test/*.test.ts",
    "test:live": "node scripts/test-live.ts",
    "typecheck": "tsc --noEmit",
    "pack:dry": "npm pack --dry-run --ignore-scripts --allow-directory=all",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.2",
    "@2h2d/ts-config": "0.0.1",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.20.4",
    "oxfmt": "0.70.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2003",
    "pi-anthropic-compat": "0.0.17",
    "pi-openai-codex-compat": "0.0.29",
    "pi-system-prompt-patcher": "0.0.13",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <1.5.0",
    "@earendil-works/pi-tui": ">=1.4.0 <1.5.0",
    "typebox": "^1.3.7"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
